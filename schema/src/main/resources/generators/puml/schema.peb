@startuml
' Generated from Avro schema
' Title: Complete Schema Diagram

' Global settings
skinparam backgroundColor #F8F8F8
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam defaultFontColor #333333

' Class styles
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #666666
    ArrowColor #666666
    FontColor #333333
    StereotypeFontColor #666666
    StereotypeFontSize 9
    StereotypeFontStyle italic
}

skinparam classAttribute {
    BackgroundColor #FFFFFF
    FontColor #333333
    FontSize 9
}

' Root class style
skinparam class<<root>> {
    BackgroundColor #E6FFE6
    BorderColor #006600
    ArrowColor #006600
    FontColor #333333
    StereotypeFontColor #006600
}

' Owner class style
skinparam class<<owner>> {
    BackgroundColor #E6F3FF
    BorderColor #0066CC
    ArrowColor #0066CC
    FontColor #333333
    StereotypeFontColor #0066CC
}

' Dependent class style, an entity linked back to whatever owns it
skinparam class<<dependent>> {
    BackgroundColor #FFF3E0
    BorderColor #CC6600
    ArrowColor #CC6600
    FontColor #333333
    StereotypeFontColor #CC6600
}

' Child class style, a composite inlined into its parent
skinparam class<<child>> {
    BackgroundColor #F3F0FA
    BorderColor #7755AA
    ArrowColor #7755AA
    FontColor #333333
    StereotypeFontColor #7755AA
}

' Carrier class style, an owner that stays embedded rather than becoming rows of its own
skinparam class<<carrier>> {
    BackgroundColor #EFEAF7
    BorderColor #7755AA
    ArrowColor #7755AA
    FontColor #333333
    StereotypeFontColor #AA5577
}

' Regular record style
skinparam class<<record>> {
    BackgroundColor #FFFFFF
    BorderColor #666666
    ArrowColor #666666
    FontColor #333333
    StereotypeFontColor #666666
}

' Enum styles. Enums carry the <<enum>> stereotype, and a stereotyped element resolves against
' `class<<...>>`, so the bare `enum` block alone never reaches them
skinparam enum {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
    ArrowColor #4682B4
    FontColor #333333
    StereotypeFontColor #4682B4
}

skinparam class<<enum>> {
    BackgroundColor #F0F8FF
    BorderColor #4682B4
    ArrowColor #4682B4
    FontColor #333333
    StereotypeFontColor #4682B4
}

' Package styles
skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #CCCCCC
    FontColor #666666
}

' Arrow styles
skinparam arrow {
    Color #666666
    FontColor #666666
    FontSize 9
    Thickness 1
}

' Layout settings
left to right direction
scale 0.8
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 100
skinparam wrapWidth 200
skinparam maxMessageSize 100

' Main schema diagram
{% for entity in entities %}
{% if entity.schema.getType().name() == 'record' %}
{% set name = entity.getFullname() %}
    class {{ name }} <<{{ entity.role }}>> {
        {% for field in entity.schema.getFields() %}
        {% if field.schema().getType().name() == 'record' %}{% set type = field.schema().getFullName() %}
        {% elseif field.schema().getType().name() == 'array' %}{% set type = "List<" ~ field.schema().getElementType().getFullName() ~ ">" %}
        {% elseif field.schema().getType().name() == 'map' %}{% set type = "Map<String, " ~ field.schema().getValueType().getFullName() ~ ">" %}
        {% elseif field.schema().getType().name() == 'enum' %}{% set type = field.schema().getFullName() %}
        {% elseif field.schema().getLogicalType() is not null %}{% set type = field.schema().getType().getName() ~ " [" ~ field.schema().getLogicalType().getName() ~ "]" %}
        {% else %}{% set type = field.schema().getType().getName() %}
        {% endif %}
        + {{ field.name() | toCamelCase }}: {{ type }}

        {% endfor %}
    }
{% endif %}
{% if entity.schema.getType().name() == 'enum' %}
    enum {{ entity.getFullname() }} <<enum>> {
        {% for symbol in entity.schema.getEnumSymbols() %}
    {{ symbol }}

    {% endfor %}
    }
{% endif %}
{% endfor %}

' Relationships
{% for entity in entities %}
{% if entity.schema.getType().name() == 'record' %}
{% for field in entity.schema.getFields() %}
{% if field.schema().getType().name() == 'record' %}
{{ entity.getFullname() }} --> {{ field.schema().getFullName() }} : contains
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}

' Ownership relationships
{% for entity in entities %}
{% if entity.schema.getType().name() == 'record' %}
{% for owner in entity.getOwners() %}
{{ owner.getFullname() }} "1" --* "many" {{ entity.getFullname() }} : owns
{% endfor %}
{% endif %}
{% endfor %}


@enduml 